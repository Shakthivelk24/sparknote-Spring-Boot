@Library('Shared') _

pipeline {
    agent {
        label 'shakthiAgent'
    }

    // ============================================================
    // ENVIRONMENT
    // ============================================================

    environment {
        // Application
        APP_NAME = 'sparkNote'
        APP_VERSION = "1.0.${BUILD_NUMBER}"

        // Docker
        DOCKER_USERNAME = 'shakthivelk24'

        FRONTEND_IMAGE =
            "${DOCKER_USERNAME}/sparknote-frontend"

        BACKEND_IMAGE =
            "${DOCKER_USERNAME}/sparknote-backend"

        IMAGE_TAG = "${BUILD_NUMBER}"

        // SonarQube
        SONAR_PROJECT_KEY = 'sparkNote'

        // Trivy
        TRIVY_REPORT_DIR = 'reports/trivy'
    }

    // ============================================================
    // OPTIONS
    // ============================================================

    options {
        timestamps()

        ansiColor('xterm')

        timeout(
            time: 60,
            unit: 'MINUTES'
        )

        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

        disableConcurrentBuilds()
    }

    // ============================================================
    // STAGES
    // ============================================================

    stages {
        // ========================================================
        // 1. CHECK TOOLS
        // ========================================================

        stage('🔧 Check Tools') {
            steps {
                cleanWs()

                customLog(
                    'Checking required tools...'
                )

                check()
            }
        }

        // ========================================================
        // 2. CHECKOUT
        // ========================================================

        stage('🔄 Checkout') {
            steps {
                customLog(
                    'Checking out source code...'
                )

                checkout scm

                bat '''
                    echo ========================================
                    echo Git Information
                    echo ========================================

                    git log --oneline -5

                    echo.
                    echo Current Git Status

                    git status
                '''
            }
        }

        // ========================================================
        // 3. INSTALL DEPENDENCIES
        // ========================================================

        stage('📦 Install Dependencies') {
            parallel {
                // ------------------------------------------------
                // FRONTEND
                // ------------------------------------------------

                stage('Frontend Dependencies') {
                    steps {
                        customLog(
                            'Installing React dependencies...'
                        )

                        npmInstall('frontend')
                    }
                }

                // ------------------------------------------------
                // BACKEND
                // ------------------------------------------------

                stage('Backend Dependencies') {
                    steps {
                        dir('BlogApplication') {
                            customLog(
                                'Installing Spring Boot dependencies...'
                            )

                            withCredentials([
                                file(
                                    credentialsId: 'blogapplication-env',
                                    variable: 'ENV_FILE'
                                )
                            ]) {
                                bat '''
                                    echo ========================================
                                    echo Creating Spring Boot environment file
                                    echo ========================================

                                    copy /Y "%ENV_FILE%" ".env"

                                    echo.
                                    echo Downloading Maven dependencies...

                                    mvn dependency:go-offline
                                '''
                            }
                        }
                    }
                }
            }
        }

        // ========================================================
        // 4. RUN TESTS
        // ========================================================

        stage('🧪 Run Tests') {
            steps {
                // ==================================================
                // FRONTEND TESTS
                // ==================================================

                script {
                    customLog(
                        'Running React tests with coverage...'
                    )

                    npmTest(
                        'frontend',
                        'vitest',
                        'coverage',
                        'junit.xml'
                    )
                }

                // ==================================================
                // BACKEND TESTS
                // ==================================================

                dir('BlogApplication') {
                    customLog(
                        'Running Spring Boot tests with JaCoCo coverage...'
                    )

                    withCredentials([
                        file(
                            credentialsId: 'blogapplication-env',
                            variable: 'ENV_FILE'
                        )
                    ]) {
                        bat '''
                            echo ========================================
                            echo Creating .env
                            echo ========================================

                            copy /Y "%ENV_FILE%" ".env"

                            echo.
                            echo ========================================
                            echo Running Maven tests
                            echo ========================================

                            mvn clean verify

                            echo.
                            echo ========================================
                            echo Checking compiled classes
                            echo ========================================

                            if not exist "target\\classes" (
                                echo ERROR: target\\classes was NOT created
                                exit /b 1
                            )

                            echo [OK] target\\classes exists

                            echo.
                            echo ========================================
                            echo Checking JaCoCo report
                            echo ========================================

                            if not exist "target\\site\\jacoco\\jacoco.xml" (
                                echo ERROR: JaCoCo XML report was NOT created
                                exit /b 1
                            )

                            echo [OK] JaCoCo XML report exists

                            echo.
                            echo ========================================
                            echo Backend tests completed successfully
                            echo ========================================
                        '''
                    }
                }
            }
        }

        // ========================================================
        // 5. VERIFY SONARQUBE INPUTS
        // ========================================================

        stage('🔎 Verify SonarQube Inputs') {
            steps {
                customLog(
                    'Verifying SonarQube input files...'
                )

                bat '''
                    echo ========================================
                    echo SONARQUBE INPUT VERIFICATION
                    echo ========================================

                    echo.
                    echo Workspace:
                    cd

                    echo.
                    echo ========================================
                    echo 1. Spring Boot Compiled Classes
                    echo ========================================

                    if exist "BlogApplication\\target\\classes" (

                        echo [OK] BlogApplication\\target\\classes exists

                        dir "BlogApplication\\target\\classes"

                    ) else (

                        echo [ERROR] BlogApplication\\target\\classes NOT FOUND

                        exit /b 1
                    )

                    echo.
                    echo ========================================
                    echo 2. Spring Boot JaCoCo Report
                    echo ========================================

                    if exist "BlogApplication\\target\\site\\jacoco\\jacoco.xml" (

                        echo [OK] JaCoCo XML exists

                        dir "BlogApplication\\target\\site\\jacoco"

                    ) else (

                        echo [ERROR] JaCoCo XML NOT FOUND

                        exit /b 1
                    )

                    echo.
                    echo ========================================
                    echo 3. React LCOV Report
                    echo ========================================

                    if exist "frontend\\coverage\\lcov.info" (

                        echo [OK] React LCOV exists

                        dir "frontend\\coverage"

                    ) else (

                        echo [ERROR] React LCOV NOT FOUND

                        exit /b 1
                    )

                    echo.
                    echo ========================================
                    echo ALL SONARQUBE INPUTS ARE AVAILABLE
                    echo ========================================
                '''
            }
        }

        // ========================================================
        // 6. SONARQUBE ANALYSIS
        // ========================================================

        stage('🔍 SonarQube Analysis') {
            steps {
                customLog(
                    'Running SonarQube analysis for React + Spring Boot...'
                )

                script {
                    def scannerHome =
                        tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        bat """
                            echo ========================================
                            echo SONARQUBE ANALYSIS
                            echo ========================================

                            echo.
                            echo Scanner:
                            echo ${scannerHome}

                            echo.
                            echo Project:
                            echo ${SONAR_PROJECT_KEY}

                            echo.
                            echo ========================================

                            "${scannerHome}\\bin\\sonar-scanner.bat" ^
                            -Dsonar.projectKey="${SONAR_PROJECT_KEY}" ^
                            -Dsonar.projectName="${APP_NAME}" ^
                            -Dsonar.projectVersion="${APP_VERSION}" ^
                            -Dsonar.sources="frontend/src,BlogApplication/src" ^
                            -Dsonar.exclusions="**/node_modules/**,**/dist/**,**/build/**,**/coverage/**,**/lcov-report/**,**/target/**,**/src/test/**,**/*.test.js,**/*.test.jsx,**/*.spec.js,**/*.spec.jsx" ^
                            -Dsonar.java.binaries="BlogApplication/target/classes" ^
                            -Dsonar.javascript.lcov.reportPaths="frontend/coverage/lcov.info" ^
                            -Dsonar.coverage.jacoco.xmlReportPaths="BlogApplication/target/site/jacoco/jacoco.xml" ^
                            -Dsonar.scanner.skipSystemTruststore=true
                        """
                    }
                }
            }
        }

        // ========================================================
        // 7. QUALITY GATE
        // ========================================================

        stage('✅ Quality Gate') {
            steps {
                customLog(
                    'Waiting for SonarQube quality gate...'
                )

                script {
                    timeout(
                        time: 5,
                        unit: 'MINUTES'
                    ) {
                        waitForQualityGate(
                            abortPipeline: true
                        )
                    }
                }
            }
        }

        // ========================================================
        // 8. VERIFY BUILD OUTPUTS
        // ========================================================

        stage('🔎 Verify Build Outputs') {
            steps {
                customLog(
                    'Verifying application build outputs...'
                )

                bat '''
                    echo ========================================
                    echo FINAL BUILD OUTPUT VERIFICATION
                    echo ========================================

                    echo.
                    echo Spring Boot target directory:

                    dir "BlogApplication\\target"

                    echo.
                    echo Spring Boot compiled classes:

                    if exist "BlogApplication\\target\\classes" (
                        echo [OK] Spring Boot classes available
                    ) else (
                        echo [ERROR] Spring Boot classes missing
                        exit /b 1
                    )

                    echo.
                    echo JaCoCo:

                    if exist "BlogApplication\\target\\site\\jacoco\\jacoco.xml" (
                        echo [OK] JaCoCo report available
                    ) else (
                        echo [ERROR] JaCoCo report missing
                        exit /b 1
                    )

                    echo.
                    echo React coverage:

                    if exist "frontend\\coverage\\lcov.info" (
                        echo [OK] React LCOV report available
                    ) else (
                        echo [ERROR] React LCOV report missing
                        exit /b 1
                    )

                    echo.
                    echo ========================================
                    echo BUILD OUTPUTS VERIFIED SUCCESSFULLY
                    echo ========================================
                '''
            }
        }
        // ================================
        //
        //
        stage('🏗️ Build Application') {
                stage('Build Frontend') {
                    steps {
                        customLog('Building frontend...')
                        frontendBuild('client')
                    }
                }
        }
        stage('🔑 Docker Login') {
            steps {
                customLog('Logging in to Docker Hub...')
                dockerLogin()
            }
        }
        stage('🐳 Build Docker Images') {
            parallel {
                stage('Build Frontend Image') {
                    steps {
                        customLog('Building frontend Docker image...')

                        dockerBuild(
                           FRONTEND_IMAGE,
                           'docker/frontend/Dockerfile',
                           '.',
                           IMAGE_TAG
                        )
                    }
                }

                stage('Build Backend Image') {
                    steps {
                        customLog('Building backend Docker image...')

                        dockerBuild(
                          BACKEND_IMAGE,
                          'docker/backend/Dockerfile',
                          '.',
                          IMAGE_TAG
                        )
                    }
                }
            }
        }
    }

    // ============================================================
    // POST ACTIONS
    // ============================================================

    post {
        success {
            echo '''
            ========================================
               🎉 PIPELINE SUCCESS
            ========================================
            '''
        }

        failure {
            echo '''
            ========================================
               ❌ PIPELINE FAILED
            ========================================
            '''
        }

        always {
            echo '''
            ========================================
               Pipeline execution completed.
            ========================================
            '''

            // Remove Jenkins workspace .env
            bat '''
                if exist "BlogApplication\\.env" (
                    del /F /Q "BlogApplication\\.env"
                    echo .env removed from workspace.
                )
            '''
        }
    }
}
